{
  "manifest_version": 3,
  "name": "ESF Bio Auth",
  "version": "0.1.52",
  "version_name": "0.1.52",
  "key": "",
  "description": "Local biometric gate for certificate-based ESF sessions.",
  "permissions": ["nativeMessaging", "storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://esf.gov.kz/*",
    "https://test3.esf.kgd.gov.kz/*",
    "wss://127.0.0.1:13579/*",
    "wss://localhost:13579/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' wss://127.0.0.1:13579 wss://localhost:13579"
  },
  "action": {
    "default_title": "ESF Bio Auth",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://esf.gov.kz/*",
        "https://test3.esf.kgd.gov.kz/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-ncalayer.js", "page-network-debug.js", "icons/icon-48.png"],
      "matches": [
        "https://esf.gov.kz/*",
        "https://test3.esf.kgd.gov.kz/*"
      ]
    }
  ]
}
