{
  "manifest_version": 3,
  "name": "ESF Touch ID Auth",
  "version": "0.1.4",
  "version_name": "0.1.04",
  "key": "",
  "description": "Local Touch ID gate for certificate-based ESF sessions.",
  "permissions": ["nativeMessaging", "storage"],
  "action": {
    "default_title": "ESF Auth",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
