{
  "manifest_version": 3,
  "name": "ESF Touch ID Auth",
  "version": "0.1.27",
  "version_name": "0.1.27",
  "key": "",
  "description": "Local Touch ID gate for certificate-based ESF sessions.",
  "permissions": ["nativeMessaging", "storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://esf.gov.kz/*",
    "wss://127.0.0.1:13579/*",
    "wss://localhost:13579/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' wss://127.0.0.1:13579 wss://localhost:13579"
  },
  "action": {
    "default_title": "ESF Auth",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://esf.gov.kz/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-ncalayer.js"],
      "matches": ["https://esf.gov.kz/*"]
    }
  ]
}
